{
  "name": "re-ray-server",
  "version": "0.1.0",
  "description": "Re-Ray(晩ご飯はtype-C)のサーバー側(管理PC・検証用)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "fake": "tsx tools/fake-device.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:app": "docker compose --profile app up -d --build",
    "test:mysql": "tsx --test src/storage/mysql.integration.ts",
    "web:mock": "node web/serve.js",
    "load-test": "tsx tools/load-test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuki20060410/Re-Ray_Server.git"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "mqtt": "^5.16.1",
    "mysql2": "^3.24.6"
  }
}
