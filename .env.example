# 接続情報のひな形。これをコピーして .env を作り、自分の値を入れる(.env は git に入らない)
#   Copy-Item .env.example .env   (PowerShell)
# 値は Docker(compose.yaml)とサーバーアプリの両方が読む

# MQTT ブローカー(Docker の Mosquitto。検証用なので認証なし)
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASS=

# MySQL(Docker の MySQL)
DB_HOST=localhost
# PC に別の MySQL(3306)が入っていてもぶつからないよう、Docker の MySQL は 3307 で出す
DB_PORT=3307
DB_USER=reray
DB_NAME=reray
# パスワードは各自で決めて入れる(空のままだと docker compose が止まる)
DB_PASS=
DB_ROOT_PASS=
