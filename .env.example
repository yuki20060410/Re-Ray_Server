# 接続情報のひな形。これをコピーして .env を作り、自分の値を入れる(.env は git に入らない)
#   Copy-Item .env.example .env   (PowerShell)
# 値は Docker(compose.yaml)とサーバーアプリの両方が読む

# MQTT ブローカー(Docker の Mosquitto。検証用なので認証なし)
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASS=

# MySQL(Docker の MySQL)
DB_HOST=localhost
# PC に別の MySQL(3306)が入っていてもぶつからないよう、Docker の MySQL は 3307 で出す
DB_PORT=3307
DB_USER=reray
DB_NAME=reray
# パスワードは各自で決めて入れる(空のままだと docker compose が止まる)
DB_PASS=
DB_ROOT_PASS=

# ---- 2026-11-06 追加 ----
# 保存先。memory = メモリ版(再起動で消える。Docker の MySQL が要らない)、mysql = 上の MySQL
STORAGE=mysql
# 管理画面と API のポート(http://localhost:3000)
HTTP_PORT=3000
# 1 = 管理画面の「テスト用」の欄と、サーバーの中の偽の端末を使う(検証用。本物の端末だけで試すときは 0)
DEV_TOOLS=0
# DEV_TOOLS=1 のとき、起動時につなぐ偽の端末
DEV_FAKES=dev-001,dev-002,dev-003
